<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khoanh Tìm"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Giữ ngay thanh điều hướng mặc định của máy để gọi Circle to Search &amp; Gemini — app chỉ đặt một vùng chạm vô hình đè đúng lên thanh đó, không thêm thanh lạ nào. Không cần root."
            android:textColor="#A8A8B3"
            android:textSize="14sp" />

        <!-- Cong tac thanh cu chi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thanh cử chỉ (vô hình, trên thanh của máy)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServiceState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Đang tắt"
                    android:textColor="#A8A8B3"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="THIẾT LẬP THEO THỨ TỰ"
            android:textColor="#7FB4FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Buoc 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 · Hiển thị trên ứng dụng khác"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Bắt buộc để đặt vùng chạm vô hình đè đúng lên thanh điều hướng mặc định ở cạnh dưới màn hình."
                android:textColor="#A8A8B3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa bật"
                    android:textColor="#FFB74D"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mở cài đặt" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buoc 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 · Đặt Google làm trợ lý mặc định"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Lệnh kích hoạt được trao cho trợ lý mặc định — phải là Google thì mới ra Circle to Search."
                android:textColor="#A8A8B3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusAssistant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa đặt"
                    android:textColor="#FFB74D"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAssistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mở cài đặt" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buoc 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 · Tự ẩn thông báo hệ thống (tuỳ chọn)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cho app quyền đọc thông báo để tự ẩn dòng “đang hiển thị trên ứng dụng khác”. App chỉ ẩn đúng thông báo đó."
                android:textColor="#A8A8B3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusNotif"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa bật"
                    android:textColor="#FFB74D"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mở cài đặt" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buoc 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 · Không giới hạn pin + tự khởi chạy"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Máy Vivo/Xiaomi/OPPO hay giết ứng dụng nền làm thanh cử chỉ chết. Bỏ giới hạn pin cho Khoanh Tìm, và bật Tự khởi chạy cho cả Khoanh Tìm lẫn ứng dụng Google."
                android:textColor="#A8A8B3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusBattery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đang bị giới hạn"
                    android:textColor="#FFB74D"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bỏ giới hạn pin" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mở trang Tự khởi chạy của hãng" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#E50914"
            android:text="Thử kích hoạt ngay"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mẹo: thêm nút “Khoanh Tìm” vào bảng Cài đặt nhanh (kéo từ trên xuống, bấm sửa) để kích hoạt nhanh. Riêng máy Xiaomi/HyperOS: cử chỉ giữ thanh bị XiaoAI giữ riêng cho nó, app bên ngoài không giành được — hãy dùng chế độ điều hướng Nút bấm rồi giữ nút Home (hệ thống tự gọi trợ lý mặc định Google), hoặc vào Cài đặt → Cài đặt bổ sung → Phím tắt cử chỉ → Chạm vào mặt lưng, gán chạm 2 lần mở ứng dụng “Mở Circle to Search”. Ra được đúng Circle to Search hay Gemini còn tuỳ máy: Google quyết định theo dòng máy và phiên bản ứng dụng Google."
            android:textColor="#6E6E7A"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
